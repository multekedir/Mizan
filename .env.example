# ── Backend ───────────────────────────────────────────────────────────────────
# URL of the Python assistant backend. Defaults to http://localhost:8000
VITE_ASSISTANT_URL=http://localhost:8000

# ── Google Calendar (optional) ────────────────────────────────────────────────
# Google OAuth Web Client ID (Calendar API enabled; calendar scope)
VITE_GOOGLE_CLIENT_ID=

# Google API key (for public calendar access without OAuth)
VITE_GOOGLE_API_KEY=

# Shared calendar ID or "primary"
VITE_GOOGLE_CALENDAR_ID=primary

# ── Weather (optional) ────────────────────────────────────────────────────────
# OpenWeatherMap API key (current weather widget)
VITE_OPENWEATHER_API_KEY=

# ── Mother’s Day splash (optional) ───────────────────────────────────────────────
# Full-screen splash on load (same URL as the app). Restart dev or rebuild after changing.
# VITE_MOTHERS_DAY_INTRO=true
